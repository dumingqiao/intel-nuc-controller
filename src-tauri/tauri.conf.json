{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intel NUC Control Center",
  "version": "../package.json",
  "identifier": "dev.nuc-x15.controller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Intel NUC Control Center",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 780,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": [
          "uniwill-laptop-dkms (>= 0.1.2-1)"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "uniwill-laptop-dkms >= 0.1.2"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
